@lkal "0.1"

lkal-schema = "0.2"
id = "nayutar/envelope"
version = "0.1.0"

root {
  field "meta" { required = true, use = &def/meta }
  field "spec" { type = .any }
  field "status" { use = &def/status }
}

def "meta" {
  type = .record
  field "group" { type = .string, pattern = "[a-z0-9-]+(\\.[a-z0-9-]+)+" }
  field "kind" { required = true, type = .string, pattern = "[a-z][a-z0-9]*" }
  field "name" { required = true, type = .string, max-length = 253 }
  field "labels" {
    type = .map
    value { type = .string }
  }
  field "uid" {
    type = .string
    pattern = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    ext { writer = .server }
  }
  field "revision" {
    type = .int
    min = 1
    ext { writer = .server }
  }
  field "generation" {
    type = .int
    min = 1
    ext { writer = .server }
  }
}

def "status" {
  type = .record
  field "observedGeneration" { type = .int, min = 1 }
  field "condition" {
    type = .map
    key { pattern = "[A-Z][A-Za-z0-9]{0,62}" }
    value { use = &def/condition }
  }
}

def "condition" {
  type = .record
  field "state" { required = true, type = .enum, values = [.true, .false, .unknown] }
  field "reason" { required = true, type = .string, max-length = 1024, pattern = "[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?" }
  field "since" { type = .string, pattern = "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z" }
}
